#!/usr/bin/env sh
echo "🔍 Running pre-commit checks..."

# Run frontend tests
if [ -d "frontend" ]; then
  echo "📝 Running frontend tests..."
  cd frontend && npm test || {
    echo "❌ Tests failed. Please fix them before committing."
    exit 1
  }
  cd ..
fi

# Quick backend sanity (full test suite is ~5min — CI runs it).
# Just check that the project imports + migrations are consistent.
if [ -f "backend/manage.py" ]; then
  if [ -x "backend/venv/Scripts/python.exe" ]; then
    PYBIN="venv/Scripts/python.exe"
  elif [ -x "backend/venv/bin/python" ]; then
    PYBIN="venv/bin/python"
  else
    PYBIN=""
  fi
  if [ -n "$PYBIN" ]; then
    echo "📝 Running backend check..."
    (cd backend && ./$PYBIN manage.py check) || {
      echo "❌ Backend check failed. Fix before committing."
      exit 1
    }
  else
    echo "ℹ️  Backend venv not detected — skipping check (full suite runs in CI)."
  fi
fi

echo "✅ Pre-commit checks passed!"
