# HeartBox Frontend Environment Variables
# Copy this file to .env and fill in the actual values

# ============================================
# REQUIRED
# ============================================

# Backend API URL (no trailing slash)
# Development: http://localhost:8000
# Production: https://api.heartbox.tw
VITE_API_URL=http://localhost:8000


# ============================================
# OPTIONAL (but recommended for full features)
# ============================================

# Google OAuth Client ID (for Google login)
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=

# Web Push Notifications (VAPID Public Key)
# Generate using: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# Sentry Error Tracking (DSN)
# Get from: https://sentry.io/settings/projects/
# Only used in production builds
VITE_SENTRY_DSN=


# ============================================
# NOTES
# ============================================

# 1. All variables prefixed with VITE_ are exposed to the client
# 2. Never commit the actual .env file with real credentials
# 3. The frontend validates required variables on startup
# 4. See src/config/env.js for validation logic
