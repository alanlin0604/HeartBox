VITE_API_URL=https://api.heartbox.tw/api
# WebSocket endpoint — same Cloud Run service via the api.heartbox.tw
# custom domain. Without this, NotificationBell.jsx falls back to
# wss://${window.location.host}/ws/notifications/ = wss://heartbox.tw/...
# which hits Cloudflare Pages (static-only, no WebSocket relay), so the
# connection never establishes and the `note_analyzed` event from the
# AI worker never reaches an open NoteDetailPage. That was the
# "AI feedback only appears after refresh" bug — fixed 2026-05-24.
VITE_WS_URL=wss://api.heartbox.tw
