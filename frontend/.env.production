VITE_API_URL=https://api.heartbox.tw/api
# WebSocket endpoint — points DIRECTLY at Cloud Run's *.run.app domain,
# bypassing the Cloudflare Worker that fronts api.heartbox.tw. The
# Worker throws on WebSocket upgrade requests (verified 2026-05-24:
# `curl -i https://api.heartbox.tw/ws/notifications/` returns
# `HTTP/1.1 500 Internal Server Error` with title "Worker threw
# exception"), so every WS connection died <30 ms after handshake and
# the `note_analyzed` event never reached the browser — users had to
# manually refresh to see AI analysis. Direct Cloud Run hits the
# Google Frontend LB, which has working WS support.
#
# Cert: the run.app hostname is covered by Google's *.run.app wildcard,
# so WSS works without extra cert config.
# Origin: DJANGO_ALLOWED_HOSTS includes `.run.app`, which matches any
# project's hostname — so this survives a project move without a backend
# env change.
#
# The hostname embeds the GCP project number, so it changes whenever the
# backend moves projects. Was heartbox-api-598139488748 (project
# `heartbox-app`, deleted 2026-07); now project `heartbox-tw`.
VITE_WS_URL=wss://heartbox-api-521869298949.asia-east1.run.app
