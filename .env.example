# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Neon PostgreSQL — omit to use SQLite)
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# AI (self-hosted LLM — replaces OpenAI as of Phase 0b)
# For local dev, LLM_PROVIDER=mock returns deterministic canned text so
# AI endpoints work without standing up the inference server. To talk to
# a real llm_server (TAIDE + LLaVA), set remote_taide and fill the URL/key.
LLM_PROVIDER=mock
LLM_SERVER_URL=
LLM_SERVER_API_KEY=
LLM_MODEL=taide-lx-7b-chat
LLM_VISION_MODEL=llava-v1.6-mistral-7b
LLM_TIMEOUT_S=30

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_db
# Embedding model used by the knowledge base. bge-m3 replaced
# text-embedding-ada-002 in the Phase 0b migration; the collection name
# changes accordingly so a stale index is never queried with the wrong model.
CHROMA_COLLECTION_NAME=psychology_kb_bgem3

# Redis (for WebSocket channel layer — omit for InMemory)
REDIS_URL=

# CORS / CSRF (production only)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Email (omit EMAIL_BACKEND for console backend in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@heartbox.app

# Rate limiting (optional overrides)
THROTTLE_USER=200/hour
THROTTLE_LOGIN=10/hour
THROTTLE_LOGIN_PER_USERNAME=10/hour
THROTTLE_REGISTER=5/hour
THROTTLE_PASSWORD_RESET=5/hour

# Google OAuth (allauth social login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cron secret (REQUIRED for /api/internal/cron/* — endpoints refuse if unset)
CRON_SECRET=

# Sentry error tracking (leave blank to disable)
SENTRY_DSN=

# Web push (VAPID) — backend signs notifications with the private half
VAPID_PRIVATE_KEY=

# GCS media (leave blank to use local FileSystemStorage)
GS_BUCKET_NAME=

# CSP host overrides (narrows connect-src; leave blank to fall back to https:/wss:)
CSP_API_HOST=
CSP_WS_HOST=

# Email transport extras
EMAIL_USE_SSL=False

# Celery (falls back to REDIS_URL then redis://localhost:6379/0)
CELERY_BROKER_URL=

# WebSocket — keep False in prod (QS tokens leak into access logs)
WS_ALLOW_QUERY_STRING_TOKEN=False

# Capstone OOM mitigation — KEEP =1 until post-defense per OOM runbook.
# Set to empty / unset to re-enable the RAG auto-bootstrap path that loads
# bge-m3 + sentence-transformers on first feedback request (~1.5GB extra
# resident at min-instances=1; OOM-killed our 2Gi container 2026-06-24).
CHROMA_DISABLE_AUTO_BOOTSTRAP=1

# Optional infra knobs
DISABLE_AI_PREWARM=
HEARTBOX_ML_MODEL_DIR=
